# Slice audio tracks
slice_audio() {
  local infile start duration ext base outfile

  if [[ $# -lt 3 ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    echo "Usage: slice_audio <input> <start> <duration>"
    echo "Example: slice_audio file.m4b 00:01:30 00:10:00"
    echo "Formats: m4b, m4a, mp3, wav, ogg, flac, aac, aiff, opus, wma, alac, ac3, amr"
    return 1
  fi

  if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Error: ffmpeg is not installed." >&2
    return 1
  fi

  infile="$1"; start="$2"; duration="$3"
  ext="${infile##*.}"; base="${infile%.*}"
  outfile="${base}_output.${ext}"

  if ffmpeg -ss "$start" -i "$infile" -t "$duration" -c copy "$outfile"; then
    echo "Created $outfile"
  fi
}

# Concatenate multiple audio files
concat_audio() {
  local input_list output opt listfile f status
  local -a files
  local OPTIND=1

  while getopts "i:o:" opt; do
    case $opt in
      i) input_list=$OPTARG ;;
      o) output=$OPTARG ;;
      *) return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  [[ -n $input_list && -n $output ]] || {
    echo "Usage: concat_audio -i file1,file2 -o output" >&2
    return 1
  }

  if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Error: ffmpeg is not installed." >&2
    return 1
  fi

  listfile="$(mktemp "${TMPDIR:-/tmp}/concat_audio.XXXXXX")" || return
  IFS=',' read -rA files <<< "$input_list"
  for f in "${files[@]}"; do
    printf "file '%s/%s'\n" "$(pwd)" "$f" >> "$listfile"
  done

  ffmpeg -f concat -safe 0 -i "$listfile" \
    -map 0:a:0 -c:a copy \
    -map_metadata 0 -map_chapters 0 \
    -movflags +faststart \
    "$output"
  status=$?

  rm -f "$listfile"
  return "$status"
}

